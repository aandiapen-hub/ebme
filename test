    capitalprojectstatusshortname = models.CharField(db_column='CapitalProjectStatusShortName', max_length=255, blank=True, null=True)  # Field name made lowercase.
    capitalprojectstatusdescription = models.TextField(db_column='CapitalProjectStatusDescription', blank=True, null=True)  # Field name made lowercase.
    inactive = models.BooleanField(db_column='Inactive', blank=True, null=True)  # Field name made lowercase.

    class Meta:
        managed = False
        db_table = 'capital_project_status'

