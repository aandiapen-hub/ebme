class CapitalProject(models.Model):
    capitalprojectid = models.BigIntegerField(primary_key=True, max_length=50)  # Field name made lowercase.
    capitalprojectcode = models.CharField(max_length=50, blank=True, null=True)  # Field name made lowercase.
    capitalprojectshortname = models.CharField(max_length=255, blank=True, null=True)  # Field name made lowercase.
    capitalprojectdescription = models.TextField(blank=True, null=True)  # Field name made lowercase.
    capitalprojectnotes = models.TextField(blank=True, null=True)  # Field name made lowercase.
    capitalprojecttypeid = models.ForeignKey('CapitalProjectType', models.DO_NOTHING, db_column='CapitalProjectTypeId', blank=True, null=True)  # Field name made lowercase.
    capitalprojectstatusid = models.ForeignKey('CapitalProjectStatus', models.DO_NOTHING, db_column='CapitalProjectStatusId', blank=True, null=True)  # Field name made lowercase.
    responsibleid = models.ForeignKey('CustomUser', models.DO_NOTHING, db_column='ResponsibleId', blank=True, null=True)  # Field name made lowercase.
    closedate = models.DateTimeField(db_column='CloseDate', blank=True, null=True)  # Field name made lowercase.
    creationdate = models.DateTimeField(db_column='CreationDate', blank=True, null=True)  # Field name made lowercase.
    modificationdate = models.DateTimeField(blank=True, null=True)  # Field name made lowercase.
    inactive = models.BooleanField(db_column='Inactive', blank=True, null=True)  # Field name made lowercase.
    startdate = models.DateTimeField(db_column='StartDate', blank=True, null=True)  # Field name made lowercase.
    enddate = models.DateTimeField(db_column='EndDate', blank=True, null=True)  # Field name made lowercase.

    class Meta:
        managed = False
        db_table = 'capital_project'

